rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // For leaderboard 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        // Only allow updating stats
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gamesPlayed', 'gamesWon', 'accuracy', 'lastPlayed'])
      );
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == null);
      allow create: if isSignedIn();
      // Sessions are mostly immutable once finished, but we might record the actual player later if we failed
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
